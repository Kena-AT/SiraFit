# SiraFit environment configuration (example)
#
# Copy this file to `.env` and fill in the values. Anything left blank is
# optional. Provider API keys may be supplied EITHER here (server-wide, shared
# by all users) OR per-user via the Settings → AI UI (encrypted at rest). The
# UI key always takes precedence over the env key for that user.
#
# Alternatively, point USER_KEYS_ENV_FILE at a separate .env-style file that
# holds only the provider keys you want to use — its values overlay the ones
# below. This is handy for a self-hoster who already has their own keys file.

# --- Core ---
SECRET_KEY=change-me-generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Used to encrypt user-stored API keys (Fernet). If unset, falls back to SECRET_KEY.
# IMPORTANT: rotating this value invalidates all previously stored user keys.
DATA_ENCRYPTION_KEY=

DATABASE_URL=postgresql://user:password@localhost:5432/sirafit
CORS_ORIGINS=http://localhost:4444,http://localhost:8080

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sirafit.com

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

ENVIRONMENT=development
FRONTEND_URL=http://localhost:4444

# --- AI provider keys (optional; omit to let each user supply their own) ---
GEMINI_API=
OPENROUTER_API=
ANTHROPIC_API=
OPENAI_API=
GROK_API=
MISTRAL_API=
NVIDIA_API=

# Optional: a user-supplied env file whose provider keys overlay the ones above.
# USER_KEYS_ENV_FILE=/path/to/my-ai-keys.env
